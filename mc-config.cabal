cabal-version:      3.8
name:               mc-config
version:            2.0.0 
description:        Minecraft server configuration tool
license:            MIT
license-file:       LICENSE
author:             ruzen42
maintainer:         malledeferlive@gmail.com
category:           Control
build-type:         Simple
extra-doc-files:    CHANGELOG.md

common warnings
    ghc-options: -Wall

executable mc-config
    import:           warnings
    main-is:          Main.hs
    build-depends:    base
                    , text
                    , optparse-applicative
                    , rainbow
                    , mc-config
                    , directory
                    , relude
    hs-source-dirs: app
    mixins:           
        base hiding (Prelude)
      , relude (Relude as Prelude)
      , relude 
    default-language: GHC2024

library
    import:           warnings
    exposed-modules:
        Config
        Install
        Tmux
        Logger
        Plugin.Manage
    build-depends:    base
        , rainbow
        , dhall
        , containers
        , sysinfo
        , aeson
        , process
        , relude
        , wreq
        , text-show
        , lens
        , directory
        , bytestring
        , text
        , filepath
    hs-source-dirs:   src
    mixins:           
        base hiding (Prelude)
      , relude (Relude as Prelude)
      , relude 
    default-language: GHC2024
