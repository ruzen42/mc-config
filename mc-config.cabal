cabal-version:      3.8
name:               mc-config
version:            2.0.0 
-- synopsis:
description:        Minecraft server configuration tool
license:            MIT
license-file:       LICENSE
author:             ruzen42
maintainer:         malledeferlive@gmail.com
-- copyright:
category:           Control
build-type:         Simple
extra-doc-files:    CHANGELOG.md
-- extra-source-files:

common warnings
    ghc-options: -Wall

executable mc-config
    import:           warnings
    main-is:          Main.hs
    build-depends:    base
                    , text
                    , optparse-applicative
                    , rainbow
                    , mc-config
                    , directory
    hs-source-dirs:   app
    default-language: GHC2024

library
    import:           warnings
    exposed-modules:
        Config
        Install
        Tmux
        Logger
        Plugin.Manage
    build-depends:    base
        , rainbow
        , toml-parser
        , containers
        , aeson
        , process
        , wreq
        , lens
        , directory
        , bytestring
        , text
        , filepath
    hs-source-dirs:   src
    default-language: GHC2024
